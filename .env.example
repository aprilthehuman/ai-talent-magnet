# 複製此檔案為 .env，填入你的 API Key
# cp .env.example .env

# 必填：後端（FastAPI）與 build_vector_store.py 都需要
OPENAI_API_KEY=your_openai_api_key_here

# 選填：LangSmith 追蹤（Module G / LangGraph），不設定就是關閉
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-talent-magnet

# 選填：前端（Streamlit）呼叫後端 API 的位址
# 本機開發不用設定，預設就是 http://localhost:8000
# Docker/Railway 部署時才需要指定成後端服務的實際網址，詳見 DEPLOYMENT.md
# API_BASE_URL=http://localhost:8000
